{
  "name": "react-data-table",
  "version": "0.1.0",
  "description": "A fully featured React table component built on TanStack Table and React Aria Components",
  "keywords": [
    "react",
    "table",
    "data-table",
    "tanstack-table",
    "react-aria",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KevinVandy/material-react-table.git",
    "directory": "packages/react-data-table"
  },
  "license": "MIT",
  "author": "Kevin Van Cott",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "storybook": "storybook dev -p 6007",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "clsx": "^2.1.1",
    "highlight-words": "^2.0.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.263.0",
    "react": ">=18.0.0",
    "react-aria-components": ">=1.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@rsbuild/core": "^1.7.2",
    "@rslib/core": "^0.19.3",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-essentials": "^10.2.0",
    "@storybook/addon-links": "^10.2.0",
    "@storybook/addon-storysource": "^10.2.0",
    "@storybook/blocks": "^10.2.0",
    "@storybook/react": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-aria-components": "^1.14.0",
    "react-dom": "^19.2.3",
    "storybook": "^10.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
